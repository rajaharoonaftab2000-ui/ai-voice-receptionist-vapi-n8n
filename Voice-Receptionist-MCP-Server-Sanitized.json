      "id": "ecdc2d8c-9d6c-5e72-a0de-c6eea69590c8",
      "name": "Get Calendar Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Filter out the empty placeholder item that alwaysOutputData produces\n// when the calendar has no events (it is a single item with no keys).\nconst events = items.filter(item => Object.keys(item.json).length > 0);\n\nif (events.length === 0) {\n  return [{\n    json: {\n      available: true,\n      conflicting_events_count: 0,\n      message: 'Slot is free — no conflicting events found. You may proceed to book the appointment.'\n    }\n  }];\n}\n\nconst conflicts = events.map(e => ({\n  title: e.json.summary || '(no title)',\n  start: (e.json.start && (e.json.start.dateTime || e.json.start.date)) || 'unknown',\n  end:   (e.json.end   && (e.json.end.dateTime   || e.json.end.date))   || 'unknown',\n}));\n\nreturn [{\n  json: {\n    available: false,\n    conflicting_events_count: events.length,\n    conflicting_events: conflicts,\n    message: events.length + ' conflicting event(s) found in this window. The slot is NOT available — please offer the caller an alternative time.'\n  }\n}];"
      },
      "id": "c0a314f4-bd11-51e8-8bc5-9724d384c308",
      "name": "Format Availability Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
