      "parameters": {
        "description": "Returns the current date and time in ISO 8601 format. Always call this first when the caller uses relative date expressions like \"today\", \"tomorrow\", \"next Monday\", or \"this week\", so you can calculate the exact calendar date before checking availability or booking.",
        "jsCode": "const now = new Date(); const offset = 5 * 60 * 60 * 1000; const pkt = new Date(now.getTime() + offset); return pkt.toISOString().replace('Z', '+05:00');"
      },
      "id": "d5f2b718-7164-5be9-ae9b-80c6b21401f0",
